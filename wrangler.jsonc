{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agendo",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
