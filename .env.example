# Copier ce fichier vers .env.local pour `npm run dev` et `npm run build`.
# Ne jamais commiter .env.local. Aucun secret ne doit figurer dans le dépôt.

# Projet Supabase déjà créé.
# URL publique (pas un secret) — ref dilkyofvugsaoqrawnwm, région eu-west-3.
NEXT_PUBLIC_SUPABASE_URL=https://dilkyofvugsaoqrawnwm.supabase.co
# Project Settings → API → clé « anon » / « public ».
# La coller ici en local, et dans Cloudflare. Ne jamais la commiter.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique canonique, sans slash final. Défaut dans le code : https://sheensy.com
# En local, vous pouvez mettre http://localhost:3000 pour les liens d’e-mail.
NEXT_PUBLIC_SITE_URL=https://sheensy.com

# Plus utilisée par l’application. Conservée pour ne pas casser un .env.local déjà en place.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optionnel. Réservé à la route /api/cron/rappels (lecture de email_outbox).
# L'espace pro, l'inscription et la réservation fonctionnent sans cette clé.
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel. Protège la route des rappels. À définir aussi dans Cloudflare
# si vous branchez un Cron Trigger plus tard.
REMINDERS_CRON_SECRET=

# Optionnel. Synchro Google Agenda — structure seulement, non activée en V1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
