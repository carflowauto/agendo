# Copier ce fichier vers .env.local pour `npm run dev` et `npm run build`.
# Ne jamais commiter .env.local. Aucun secret ne doit figurer dans le dépôt.

# Projet Supabase déjà créé.
# URL publique (pas un secret) — ref dilkyofvugsaoqrawnwm, région eu-west-3.
NEXT_PUBLIC_SUPABASE_URL=https://dilkyofvugsaoqrawnwm.supabase.co
# Project Settings → API → clé « anon » / « public ».
# La coller ici en local, et dans Cloudflare. Ne jamais la commiter.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique canonique, sans slash final. Défaut dans le code : https://sheensy.com
# En local, vous pouvez mettre http://localhost:3000 pour les liens d’e-mail.
NEXT_PUBLIC_SITE_URL=https://sheensy.com

# Plus utilisée par l’application. Conservée pour ne pas casser un .env.local déjà en place.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mails transactionnels (secrets du worker en production, jamais dans Git).
# RESEND_API_KEY : clé Resend (domaine sheensy.com vérifié).
# EMAIL_QUEUE_SECRET : secret de la file email_outbox ; son hash SHA-256 va dans private.email_queue_config.
RESEND_API_KEY=
EMAIL_QUEUE_SECRET=

# Connexion Google Agenda (synchro dans les deux sens). Secrets du worker, jamais dans Git.
# Tant que GOOGLE_CLIENT_ID et GOOGLE_CLIENT_SECRET sont vides, le bouton Google n'apparaît pas
# et le cron ne fait aucun appel Google : seul le lien d'abonnement (iPhone, Outlook…) est proposé.
# GOOGLE_TOKEN_KEY : 32 octets aléatoires en base64 (chiffrement AES-GCM des jetons Google).
# GOOGLE_REDIRECT_URI : facultatif, défaut https://sheensy.com/api/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=
GOOGLE_REDIRECT_URI=
